{
  "name": "profiletty",
  "version": "0.1.0",
  "description": "Terminal-style GitHub profile cards as static SVGs, generated from a local ASCII file and a JSON config.",
  "keywords": [
    "github-profile",
    "readme",
    "svg",
    "ascii",
    "terminal",
    "neofetch"
  ],
  "homepage": "https://github.com/KaduKessler/profiletty#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaduKessler/profiletty.git"
  },
  "bugs": {
    "url": "https://github.com/KaduKessler/profiletty/issues"
  },
  "author": "Carlos Kessler (https://github.com/KaduKessler)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node src/cli.ts examples/profile.json dist",
    "card": "node src/cli.ts",
    "docs": "node src/cli.ts examples/profile.json docs && node -e \"require('fs').rmSync('docs/README.md')\"",
    "test": "node --test test/*.test.ts"
  }
}
